# =============================================================================
# OmniFix Environment Configuration
# =============================================================================

# ---- Application ----
APP_NAME=OmniFix
APP_ENV=development
DEBUG=true
SECRET_KEY=omnifix-super-secret-key-change-in-production

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000
MCP_HOST=0.0.0.0
MCP_PORT=9000

# ---- LLM Provider (set ONE) ----
# Leave empty to use offline mock LLM (default for judges)
LLM_PROVIDER=mock       # options: mock | openai | anthropic | ollama | gemini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Redis (state management) ----
REDIS_URL=redis://localhost:6379/0

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./omnifix.db
# For PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+asyncpg://omnifix:omnifix@localhost:5432/omnifix

# ---- Confidence Threshold (below = human-in-loop) ----
HITL_CONFIDENCE_THRESHOLD=0.70

# ---- External Integrations (all optional) ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_BOT_TOKEN=
NOTION_TOKEN=
GITHUB_TOKEN=
GOOGLE_DRIVE_CREDENTIALS=

# ---- Feature Flags ----
ENABLE_PLAYWRIGHT=false
ENABLE_OCR=false
ENABLE_REAL_EMAIL=false
DEMO_MODE=true          # Uses simulated data for judge demos
